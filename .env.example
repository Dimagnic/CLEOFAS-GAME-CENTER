# --- Navegador (Vite) ---
VITE_SUPABASE_URL=https://tuproyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# --- Servidor (funciones /api en Vercel). NO llevan prefijo VITE_ ---
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: tu dominio final (si no, se detecta solo)
# SITE_URL=https://cleofas-game-center.vercel.app

# --- Correo de confirmación (Resend) ---
RESEND_API_KEY=re_...
# Con dominio verificado en Resend. Sin dominio solo puedes enviar pruebas a tu propio correo:
EMAIL_FROM=Cleofas Game Center <reservas@tudominio.mx>
# Opcional: correo del negocio que recibe copia de cada reservación pagada
EMAIL_COPIA=
